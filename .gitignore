# Documentation build products.  The site source is docs/; everything it
# generates is rebuilt by docs/build.py and must not be committed, because the
# snapshots embed checksums of the library and would go stale on every change
# to it.  docs/.gitignore covers the rest.
/docs/_site/
/docs/_site-*/
/docs/.jekyll-cache/
/docs/vendor/
/docs/.bundle/
/docs/node_modules/
/docs/_data/provenance.yml
/docs/_data/vest_diagnostics.yml
/docs/_data/formula_catalog.yml
vest_database_info.txt
/__pycache__
.ipynb_checkpoints
*__pycache__*
vaft.egg-info*
/build/
/dist/
*.snakemake
/vendor/omas/
# TES adapter run artifacts (regenerated by the notebook)
notebooks/_tes_run/
# TokaMaker adapter run artifacts (regenerated by the notebook)
notebooks/_tokamaker_run/
# Notebook run outputs and scratch files (regenerated on execution)
notebooks/temps/
notebooks/outputs/
*_executed.ipynb
# The same artifacts land at the repository root when a notebook is executed
# with the repo as the working directory rather than notebooks/, because the
# notebooks write to cwd-relative paths.
/_tes_run/
/_tokamaker_run/
/temps/
/fig4.png
# Matplotlib font caches (created when MPLCONFIGDIR points into the repo)
/.matplotlib/
/.mplconfig/
# Editor/backup leftovers
*.bak_sfix
# Pipeline run logs
workflow/**/*.log
# Local tool and editor artifacts
.claude/settings.local.json
.cursor/*.log

# macOS metadata sidecars (notably created on external SSD volumes)
._*

# Tutorial execution and LaTeX build products
/tutorial/.build/
/tutorial/outputs/

# Local VFIT MATLAB exports and scratch summary workbooks (large, not packaged)
/vaft/data/vfit/
/sample_equilibrium_global_history.xlsx

# HSDS credentials (written by `hsconfigure`; never commit a real one)
.hscfg
**/.hscfg

# Quarto render products and cache (issue #322). Presentation outputs are built
# on demand and by CI; none of them are committed.
/tutorial/**/_output/
/tutorial/**/.quarto/
/tutorial/**/_freeze/
/tutorial/presentations/**/*.html
/tutorial/presentations/**/*.pdf
/tutorial/presentations/**/*_files/
# Only the rendered deck .tex, never the theme partials in _extensions/.
/tutorial/presentations/*.tex
