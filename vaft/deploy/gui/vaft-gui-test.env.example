# /etc/vaft-gui-test.env -- read by vaft-gui-test.service; keep it 0600 root:root.
#
# The HSDS the test instance reads shots from, with the DEDICATED READ-ONLY
# service account created for it (#1862): read ACLs on the approved dataset
# domains only, no write/delete/ACL rights anywhere, and not the account the
# production vaft-gui.service uses. Every reader who signs in reads with it.
HS_ENDPOINT=http://127.0.0.1:5101
HS_USERNAME=gui-test-reader
HS_PASSWORD=change-me

# The host name readers open the page at (no scheme, no port); the unit passes it to
# --allow-websocket-origin. One name only; the server's public name, kept out of the repository.
VAFT_GUI_ORIGIN=gui.example.org
