# /etc/vaft-gui.env -- read by vaft-gui.service; keep it 0600 root:root.

# Only with --auth password (the unit uses --auth hsds: readers sign in with
# their HSDS accounts). Any user name is accepted.
# VAFT_GUI_PASSWORD=change-me

# HSDS the GUI reads shots from. Use a read-only account: every reader of
# the page reads with it, and it needs read ACLs on the shot domains (main/...),
# which a readers-group account does not get by itself. The service reaches
# HSDS on this machine directly.
HS_ENDPOINT=http://127.0.0.1:5101
HS_USERNAME=reader
HS_PASSWORD=change-me
