  "method": {
    "tree": "git ls-tree -r -l <ref>; blob sizes as stored in Git (LFS files count as pointers)",
    "history": "git rev-list --objects over every refs/remotes/origin/* branch and tag (what a full clone downloads), then git cat-file --batch-check objectsize / objectsize:disk",
