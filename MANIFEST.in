# Keep repository-only samples out of source distributions.  The wheel uses
# ``tool.setuptools.package-data``; this manifest applies the same allowlist to
# the sdist, including when an old ``SOURCES.txt`` is present locally.
graft vaft
prune vaft/data
prune test
# The documentation site is repository-only.  It is already outside the
# ``vaft*`` package glob, so nothing ships it today; say so explicitly, because
# the alternative is relying on an omission staying an omission.
prune docs
global-exclude *.py[cod]
global-exclude ._*

include vaft/data/*.py
include vaft/data/geometry/Coil_info.mat
include vaft/data/geometry/VEST_DiscretizedCoilGeometry_Full_ver_1906.mat
include vaft/data/geometry/VEST_DiscretizedCoilGeometry_Full_ver_2507.mat
include vaft/data/geometry/VEST_em_coupling_pf_versions.npz
include vaft/data/geometry/VEST_static_geometry.json.gz
include vaft/data/geometry/*.yaml
include vaft/data/geometry/*.csv
include vaft/data/geometry/camera_visible/*.json
include vaft/data/gpec/*.in
include vaft/data/gpec/*.dat
include vaft/data/legacy/*.txt
include vaft/data/legacy/*.yaml
include vaft/data/legacy/sxr_te_ratio_be_al.csv
include vaft/data/samples/*/manifest.yaml
include vaft/data/samples/39915/omas.json.gz
include vaft/data/samples/39915/imas.nc
include vaft/data/wheel_samples/39915/manifest.yaml
include vaft/data/wheel_samples/39915/omas.json.gz
include vaft/data/wheel_samples/39915/imas.nc
