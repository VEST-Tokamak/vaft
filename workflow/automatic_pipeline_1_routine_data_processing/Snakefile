        mkdir -p $(dirname {log})
        python {SCRIPT_DIR}/generate_kfile.py \
            --shot {wildcards.shot} \
            --constraints-ods {input.constraints} \
            --output {output.manifest} \
            --npprime {params.npprime} \
            --nffprime {params.nffprime} \
            > {log} 2>&1
        """

rule run_efit_reconstruction:
    input:
        kfiles=PATHS.shot_pattern("kfile_manifest")
    output:
        gfiles=PATHS.shot_pattern("gfile_manifest"),
        status=PATHS.shot_pattern("efit_status")
    log:
        PATHS.shot_pattern("log", "run_efit")
    params:
        run=bool_text(EFIT_CONFIG.get("run", False)),
        executable=EFIT_CONFIG.get("executable", ""),
        args=EFIT_CONFIG.get("args", "65"),
        timeout=EFIT_CONFIG.get("timeout", "")
    conda:
        CONDA if CONDA else None
    shell:
        """
        mkdir -p $(dirname {log})
        python {SCRIPT_DIR}/run_efit_reconstruction.py \
            --shot {wildcards.shot} \
            --kfile-manifest {input.kfiles} \
            --gfile-manifest {output.gfiles} \
            --status {output.status} \
            --run {params.run} \
            --executable "{params.executable}" \
            --args "{params.args}" \
            --timeout "{params.timeout}" \
            > {log} 2>&1
        """

rule generate_efit_ods:
    input:
        gfiles=PATHS.shot_pattern("gfile_manifest"),
