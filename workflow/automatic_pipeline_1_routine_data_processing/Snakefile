    conda:
        CONDA if CONDA else None
    shell:
        """
        mkdir -p $(dirname {log})
        python {SCRIPT_DIR}/generate_efit_ods.py \
            --shot {wildcards.shot} \
            --gfile-manifest {input.gfiles} \
            --status {input.status} \
            --output {output.ods} \
            --run {params.run} \
            > {log} 2>&1
        """

