############################################################
# CHEASE Refinement/ODS
############################################################
rule run_chease:
    input:
        gfiles="{BASE_DIR}/{shot}/efit/gfile/gfiles_generated.txt"
    output:
        refined="{BASE_DIR}/{shot}/chease/refined_gfiles_generated.txt",
        status="{BASE_DIR}/{shot}/chease/chease_status.txt"
    log:
        "{BASE_DIR}/{shot}/logs/run_chease.log"
    params:
        run=bool_text(CHEASE_CONFIG.get("run", False)),
        executable=CHEASE_CONFIG.get("executable", ""),
        timeout=CHEASE_CONFIG.get("timeout", ""),
        target_psin=CHEASE_CONFIG.get("target_psin", 0.993),
        relax=CHEASE_CONFIG.get("relax", 0.5),
        nideal=CHEASE_CONFIG.get("nideal", 6),
        nw=CHEASE_CONFIG.get("nw", 513),
        auto_cocos=bool_text(CHEASE_CONFIG.get("auto_cocos", True)),
        output_cocos=CHEASE_CONFIG.get("output_cocos", "input"),
        preserve_boundary_limiter=bool_text(CHEASE_CONFIG.get("preserve_boundary_limiter", True)),
        create_plot=bool_text(CHEASE_CONFIG.get("create_plot", True))
    conda:
        CONDA if CONDA else None
    shell:
        """
        mkdir -p {BASE_DIR}/{wildcards.shot}/chease
        mkdir -p {BASE_DIR}/{wildcards.shot}/logs
        python run_chease_refinement.py \
            --shot {wildcards.shot} \
            --gfile-manifest {input.gfiles} \
            --output {output.refined} \
            --status {output.status} \
            --run {params.run} \
            --executable "{params.executable}" \
            --timeout "{params.timeout}" \
            --target-psin {params.target_psin} \
            --relax {params.relax} \
            --nideal {params.nideal} \
            --nw {params.nw} \
            --auto-cocos {params.auto_cocos} \
            --output-cocos "{params.output_cocos}" \
            --preserve-boundary-limiter {params.preserve_boundary_limiter} \
            --create-plot {params.create_plot} \
            > {log} 2>&1
        """

rule generate_chease_ods:
    input:
        refined="{BASE_DIR}/{shot}/chease/refined_gfiles_generated.txt",
        status="{BASE_DIR}/{shot}/chease/chease_status.txt"
    output:
        ods="{BASE_DIR}/{shot}/omas/{shot}_chease.json"
    log:
        "{BASE_DIR}/{shot}/logs/generate_chease_ods.log"
    params:
        run=DIAGNOSTICS_CONFIG.get("run", 1)
    conda:
        CONDA if CONDA else None
    shell:
        """
        mkdir -p {BASE_DIR}/{wildcards.shot}/omas
        mkdir -p {BASE_DIR}/{wildcards.shot}/logs
        python generate_chease_ods.py \
            --shot {wildcards.shot} \
            --refined-gfile-manifest {input.refined} \
            --status {input.status} \
            --output {output.ods} \
            --run {params.run} \
            > {log} 2>&1
        """

############################################################
# GPEC Suite: DCON/RDCON/STRIDE/GPEC
############################################################
rule run_gpec_suite:
    input:
        refined="{BASE_DIR}/{shot}/chease/refined_gfiles_generated.txt",
        status="{BASE_DIR}/{shot}/chease/chease_status.txt"
    output:
        manifest="{BASE_DIR}/{shot}/linear_stability/gpec_suite_runs.json",
        status="{BASE_DIR}/{shot}/linear_stability/gpec_suite_status.txt"
    log:
        "{BASE_DIR}/{shot}/logs/run_gpec_suite.log"
    params:
        gpec_home=GPEC_CONFIG.get("home", "/Users/yun/git/GPEC"),
        run_mode=GPEC_CONFIG.get("run", "auto"),
        modules=csv(GPEC_CONFIG.get("modules", ["dcon", "rdcon", "stride", "gpec"])),
        modes=csv(GPEC_CONFIG.get("modes", [1, 2])),
        psilow=GPEC_CONFIG.get("psilow", 0.01),
        psihigh=GPEC_CONFIG.get("psihigh", 0.994),
        timeout=GPEC_CONFIG.get("timeout", 1200)
    conda:
        CONDA if CONDA else None
    shell:
        """
        mkdir -p {BASE_DIR}/{wildcards.shot}/linear_stability
        mkdir -p {BASE_DIR}/{wildcards.shot}/logs
        python run_gpec_suite.py \
            --shot {wildcards.shot} \
            --refined-gfile-manifest {input.refined} \
            --output {output.manifest} \
            --status {output.status} \
            --gpec-home "{params.gpec_home}" \
            --run-mode "{params.run_mode}" \
            --modules "{params.modules}" \
            --modes "{params.modes}" \
            --psilow {params.psilow} \
            --psihigh {params.psihigh} \
            --timeout {params.timeout} \
            > {log} 2>&1
        """

