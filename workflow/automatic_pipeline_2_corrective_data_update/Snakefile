###############################################################################
#  Pipeline 2 -- the Thomson lineage
#  Usage: snakemake --snakefile Snakefile --configfile config.yaml --cores 8
###############################################################################
#
# Externally uploaded profile diagnostics and what is derived from them. Every
# stage here is optional in the #305 sense: most VEST shots carry no Thomson
# upload at all, and that is a normal result rather than a failure. Each stage
# records its own absence and exits 0, so this pipeline can be pointed at the
# whole shot range without a shot without diagnostics failing the run.
#
# Pipeline 1's products (`efit`, its constraints) are passed as **params, not
# inputs**. Declaring them as inputs would make Snakemake raise for a shot
# pipeline 1 never reconstructed, which is exactly the case the stages are
# written to record instead. Each such param is declared once, in
# paths.SCIENTIFIC_REFERENCES, and built from that declaration, so the lineage
# graph (#1647) shows exactly what these rules consult.

import sys
from pathlib import Path

# The workflow's own defaults, located by this Snakefile rather than by the
# working directory: a bare "config.yaml" resolves against `--directory`, so a
# run launched with `--directory <run dir> --configfile <run dir>/config.yaml`
# re-read its own partial config and never loaded this one -- every unset key
# fell back to a code default (efit.run false, no eddy filament, #1530).
# Command-line `--configfile` files are deep-merged over these.
configfile: str(Path(workflow.basedir) / "config.yaml")

SCRIPT_DIR = Path(workflow.basedir)
PIPELINE1_DIR = SCRIPT_DIR.parent / "automatic_pipeline_1_routine_data_processing"
sys.path.insert(0, str(PIPELINE1_DIR))
from paths import (
    FILEDB,
    PipelinePaths,
    expand_config_environment,
    require_run_config_keys,
    scientific_reference,
)

require_run_config_keys(workflow)
# `${VAFT_FILEDB_DIR:-/srv/vest.filedb}` and friends, read the way pipeline 1
# reads its config (cold review 0.7.0 data F12, #1888).
config.update(expand_config_environment(config))

from vaft.database.sources import replicable_stages

PATHS = PipelinePaths.from_config(config)
if PATHS.layout != FILEDB:
    raise WorkflowError(
        "Pipeline 2 requires layout: filedb. Its stages are canonical-layout "
        "only -- the shot-first tree is a read-only legacy reference and never "
        "carried them (issues #89, #138)."
    )

BASE_DIR = config["base_dir"]
SHOTS = config["shots"]
CONDA = config.get("conda")

EXTERNAL = config.get("external", {})
DATA_ROOT = EXTERNAL.get("data_root", "")
CES_OPTIONS = EXTERNAL.get("ces_options", "ces")

KINETIC_CONFIG = config.get("kinetic", {})
KINETIC_ENCODING = KINETIC_CONFIG.get("encoding", "raw6")
KINETIC_EXECUTABLE = KINETIC_CONFIG.get("executable", "")
# Named EFIT configuration for the base magnetic kfile (vaft.code.efit.PRESETS);
# empty is the library default (statistical_891), `routine` the legacy one. Checked here so a typo fails the DAG.
KINETIC_DILUTION = KINETIC_CONFIG.get("dilution", "species")
if KINETIC_DILUTION not in ("species", "none"):
    raise WorkflowError(
        "kinetic.dilution must be 'species' or 'none', got " + repr(KINETIC_DILUTION)
    )
KINETIC_EFIT_PRESET = KINETIC_CONFIG.get("efit_preset") or ""
if KINETIC_EFIT_PRESET:
    from vaft.code.efit import efit_preset as _efit_preset
    _efit_preset(KINETIC_EFIT_PRESET)

COMPOSITION_CONFIG = config.get("composition", {}) or {}
COMPOSITION_IONIZATION = COMPOSITION_CONFIG.get("ionization", "transient")
COMPOSITION_NORMALIZATION = COMPOSITION_CONFIG.get("normalization", "ne_weighted_mean")
COMPOSITION_ADF11_CACHE = COMPOSITION_CONFIG.get("adf11_cache_dir", "") or ""

TI_INFERENCE_CONFIG = config.get("ti_inference", {}) or {}
TI_INFERENCE_FLOOR = TI_INFERENCE_CONFIG.get("floor", 0.17)
TI_INFERENCE_WINDOW_S = TI_INFERENCE_CONFIG.get("window_s", 1e-3)

RESISTIVE_CONFIG = config.get("resistive_zeff", {}) or {}
RESISTIVE_MODEL = RESISTIVE_CONFIG.get("model", "redl")
RESISTIVE_LN_LAMBDA = RESISTIVE_CONFIG.get("ln_lambda", "sauter")
RESISTIVE_BOUNDS = list(RESISTIVE_CONFIG.get("bounds", [1.0, 8.0]))
RESISTIVE_I_NI = RESISTIVE_CONFIG.get("i_ni_a", 0.0)
RESISTIVE_SMOOTHING = RESISTIVE_CONFIG.get("smoothing", {}) or {}
RESISTIVE_SMOOTHING_WINDOW_S = RESISTIVE_SMOOTHING.get("window_s")
RESISTIVE_SMOOTHING_ORDER = RESISTIVE_SMOOTHING.get("order", 2)
RESISTIVE_MAX_EXCLUDED = RESISTIVE_CONFIG.get("max_excluded_current", 0.05)
RESISTIVE_INDUCTIVE_MAX = RESISTIVE_CONFIG.get("inductive_max", 1.0)
if len(RESISTIVE_BOUNDS) != 2:
    raise WorkflowError("resistive_zeff.bounds must be [z_min, z_max]")

HSDS_CONFIG = config.get("hsds", {}) or {}
REPLICATION_ENABLED = bool(HSDS_CONFIG.get("replicate", False))
REPLICATION_ATTEMPTS = HSDS_CONFIG.get("attempts", 3)
REPLICATION_RETRY_DELAY = HSDS_CONFIG.get("retry_delay", 5.0)
# Same bound as pipeline 1: uploads are limited by the HSDS deployment, not by
# local cores, and 30 parallel uploads against a 4-node server failed on almost
# every shot.
REPLICATION_CONCURRENCY = HSDS_CONFIG.get("concurrency", 4)
workflow.global_resources.setdefault("hsds", REPLICATION_CONCURRENCY)

# The Thomson lineage: a deliberate *subset* of the corrective stages, not all
# of them. Soft X-ray and camera are ingested by
# `ingest_external_diagnostics.py`, and `neoclassical` and `turbulent_transport`
# belong to the GACODE chain, so each has its own producer and none of them
# belongs in this DAG.
#
# Named here rather than derived, because "which stages does this pipeline
# build" is a real decision -- but checked against the registry, so a stage
# renamed or retired there fails the run instead of silently dropping out of it.
THOMSON_LINEAGE = (
    "thomson", "ces", "core_profiles", "composition", "ti_inferred", "resistive_zeff",
    "electron_efit", "kinetic_efit",
)
_CORRECTIVE = frozenset(replicable_stages(produced_by="corrective"))
_UNREGISTERED = tuple(stage for stage in THOMSON_LINEAGE if stage not in _CORRECTIVE)
if _UNREGISTERED:
    raise WorkflowError(
        "These stages are not registered as corrective products in "
        "vaft.database.sources.STAGE_REPLICATION: "
        + ", ".join(_UNREGISTERED)
        + ". A workflow consumes the registry rather than restating it, so a "
        "stage renamed there must be renamed here too."
    )

STAGES = THOMSON_LINEAGE
REPLICATE_SCRIPT = PIPELINE1_DIR / "replicate_to_hsds.py"


def stage_products(shots):
    return [PATHS.shot_pattern(stage + "_ods").format(shot=shot)
            for shot in shots for stage in STAGES]


def replication_records(shots):
    return [PATHS.replication_record(shot, stage)
            for shot in shots for stage in STAGES]


rule all:
    input:
        replication_records(SHOTS) if REPLICATION_ENABLED else stage_products(SHOTS)


############################################################
# The uploads
############################################################
rule generate_thomson_ods:
    output:
        ods=PATHS.shot_pattern("thomson_ods"),
        manifest=PATHS.shot_pattern("thomson_manifest")
    log:
        PATHS.shot_pattern("log", "generate_thomson_ods")
    params:
        data_root=DATA_ROOT
    conda:
        CONDA if CONDA else None
    shell:
        """
        mkdir -p $(dirname {log})
        python {SCRIPT_DIR}/generate_thomson_ods.py \
            --shot {wildcards.shot} \
            --data-root "{params.data_root}" \
            --output {output.ods} \
            --metadata {output.manifest} \
            > {log} 2>&1
        """


rule generate_ces_ods:
    output:
        ods=PATHS.shot_pattern("ces_ods"),
        manifest=PATHS.shot_pattern("ces_manifest")
    log:
        PATHS.shot_pattern("log", "generate_ces_ods")
    params:
        data_root=DATA_ROOT,
        options=CES_OPTIONS
    conda:
        CONDA if CONDA else None
    shell:
        """
        mkdir -p $(dirname {log})
        python {SCRIPT_DIR}/generate_ces_ods.py \
            --shot {wildcards.shot} \
            --data-root "{params.data_root}" \
            --options {params.options} \
            --output {output.ods} \
            --metadata {output.manifest} \
            > {log} 2>&1
        """


############################################################
# The mapping
############################################################
rule generate_core_profiles_ods:
    input:
        thomson=PATHS.shot_pattern("thomson_ods"),
        ces=PATHS.shot_pattern("ces_ods")
    output:
        ods=PATHS.shot_pattern("core_profiles_ods"),
        manifest=PATHS.shot_pattern("core_profiles_manifest")
    log:
        PATHS.shot_pattern("log", "generate_core_profiles_ods")
    params:
        # Pipeline 1's product. A param, not an input: a shot it never
        # reconstructed must be recorded, not raised (see the header).
        efit=scientific_reference(PATHS, "generate_core_profiles_ods", "efit")
    conda:
        CONDA if CONDA else None
    shell:
        """
        mkdir -p $(dirname {log})
        python {SCRIPT_DIR}/generate_core_profiles_ods.py \
            --shot {wildcards.shot} \
            --thomson-product {input.thomson} \
            --ces-product {input.ces} \
            --efit-product {params.efit} \
            --output {output.ods} \
            --metadata {output.manifest} \
            > {log} 2>&1
        """


############################################################
# The composition overlay
############################################################
# The measured core_profiles plus the assumed C/O composition, diluted n_i and
# Z_eff(rho). Its own stage and manifest, so a shot that cannot be composed is
# recorded and keeps the measured product. Both efit and diagnostics are pipeline
# 1's products, passed as params for the reason given in the header.
rule generate_composition_ods:
    input:
        core_profiles=PATHS.shot_pattern("core_profiles_ods")
    output:
        ods=PATHS.shot_pattern("composition_ods"),
        manifest=PATHS.shot_pattern("composition_manifest")
    log:
        PATHS.shot_pattern("log", "generate_composition_ods")
    params:
        efit=scientific_reference(PATHS, "generate_composition_ods", "efit"),
        diagnostics=scientific_reference(PATHS, "generate_composition_ods", "diagnostics"),
        ionization=COMPOSITION_IONIZATION,
        normalization=COMPOSITION_NORMALIZATION,
        adf11_cache=COMPOSITION_ADF11_CACHE
    conda:
        CONDA if CONDA else None
    shell:
        """
        mkdir -p $(dirname {log})
        python {SCRIPT_DIR}/generate_composition_ods.py \
            --shot {wildcards.shot} \
            --core-profiles-product {input.core_profiles} \
            --efit-product {params.efit} \
            --diagnostics-product {params.diagnostics} \
            --ionization {params.ionization} \
            --normalization {params.normalization} \
            --adf11-cache-dir "{params.adf11_cache}" \
            --output {output.ods} \
            --metadata {output.manifest} \
            > {log} 2>&1
        """


############################################################
# The inferred ion temperature
############################################################
# T_i on the electron-only slices, from the magnetic EFIT's pressure partition,
# written over the composed profiles. It is a leaf: the kinetic lineages below
# read the composed product, never this one, because their pressure would then be
# partitioned back into the T_i it was built from.
rule generate_ti_inferred_ods:
    input:
        core_profiles=PATHS.shot_pattern("composition_ods")
    output:
        ods=PATHS.shot_pattern("ti_inferred_ods"),
        manifest=PATHS.shot_pattern("ti_inferred_manifest")
    log:
        PATHS.shot_pattern("log", "generate_ti_inferred_ods")
    params:
        efit=scientific_reference(PATHS, "generate_ti_inferred_ods", "efit"),
        floor=TI_INFERENCE_FLOOR,
        window_s=TI_INFERENCE_WINDOW_S
    conda:
        CONDA if CONDA else None
    shell:
        """
        mkdir -p $(dirname {log})
        python {SCRIPT_DIR}/generate_ti_inferred_ods.py \
            --shot {wildcards.shot} \
            --core-profiles-product {input.core_profiles} \
            --efit-product {params.efit} \
            --floor {params.floor} \
            --window-s {params.window_s} \
            --output {output.ods} \
            --metadata {output.manifest} \
            > {log} 2>&1
        """


############################################################
# The Romero resistive Z_eff
############################################################
# Lane Z's window estimate (#1214), stored in `global_quantities.z_eff_resistive`
# beside, never over, the composition Z_eff. It is built on the inferred-T_i
# product so that replacing `core_profiles` in `main` keeps what the stages before
# it wrote, and it is a leaf: nothing reads it. Its settings are stated, not
# defaulted in code -- the estimator has none -- and recorded in the product.
rule generate_resistive_zeff_ods:
    input:
        core_profiles=PATHS.shot_pattern("ti_inferred_ods")
    output:
        ods=PATHS.shot_pattern("resistive_zeff_ods"),
        manifest=PATHS.shot_pattern("resistive_zeff_manifest")
    log:
        PATHS.shot_pattern("log", "generate_resistive_zeff_ods")
    params:
        efit=scientific_reference(PATHS, "generate_resistive_zeff_ods", "efit"),
        model=RESISTIVE_MODEL,
        ln_lambda=RESISTIVE_LN_LAMBDA,
        z_min=RESISTIVE_BOUNDS[0],
        z_max=RESISTIVE_BOUNDS[1],
        i_ni=RESISTIVE_I_NI,
        smoothing=(
            "" if RESISTIVE_SMOOTHING_WINDOW_S is None
            else "--smoothing-window-s " + str(RESISTIVE_SMOOTHING_WINDOW_S)
            + " --smoothing-order " + str(RESISTIVE_SMOOTHING_ORDER)
        ),
        max_excluded=RESISTIVE_MAX_EXCLUDED,
        inductive_max=RESISTIVE_INDUCTIVE_MAX
    conda:
        CONDA if CONDA else None
    shell:
        """
        mkdir -p $(dirname {log})
        python {SCRIPT_DIR}/generate_resistive_zeff_ods.py \
            --shot {wildcards.shot} \
            --core-profiles-product {input.core_profiles} \
            --efit-product {params.efit} \
            --model {params.model} \
            --ln-lambda {params.ln_lambda} \
            --bounds {params.z_min} {params.z_max} \
            --i-ni {params.i_ni} \
            {params.smoothing} \
            --max-excluded-current {params.max_excluded} \
            --inductive-max {params.inductive_max} \
            --output {output.ods} \
            --metadata {output.manifest} \
            > {log} 2>&1
        """


############################################################
# The kinetic lineages
############################################################
# Both are asked for every shot and at most one can apply: whichever the
# core-profile product did not measure records itself unavailable and exits 0.
for _stage in ("electron_efit", "kinetic_efit"):

    rule:
        name: "generate_" + _stage + "_ods"
        input:
            # The composed product: it is the measured one plus the diluted ions
            # when the composition stage succeeded, and the measured one itself
            # (unchanged) when it did not, so this never depends on its outcome.
            core_profiles=PATHS.shot_pattern("composition_ods")
        output:
            ods=PATHS.shot_pattern(_stage + "_ods"),
            manifest=PATHS.shot_pattern(_stage + "_manifest")
        log:
            PATHS.shot_pattern("log", "generate_" + _stage + "_ods")
        params:
            stage=_stage,
            constraints=scientific_reference(PATHS, "generate_" + _stage + "_ods", "constraints"),
            efit=scientific_reference(PATHS, "generate_" + _stage + "_ods", "efit"),
            encoding=KINETIC_ENCODING,
            executable=KINETIC_EXECUTABLE,
            dilution=KINETIC_DILUTION,
            efit_preset=KINETIC_EFIT_PRESET
        conda:
            CONDA if CONDA else None
        shell:
            """
            mkdir -p $(dirname {log})
            python {SCRIPT_DIR}/generate_kinetic_efit_ods.py \
                --shot {wildcards.shot} \
                --stage {params.stage} \
                --core-profiles-product {input.core_profiles} \
                --constraints-product {params.constraints} \
                --efit-product {params.efit} \
                --encoding {params.encoding} \
                --dilution {params.dilution} \
                --executable "{params.executable}" \
                --efit-preset "{params.efit_preset}" \
                --output {output.ods} \
                --metadata {output.manifest} \
                > {log} 2>&1
            """


############################################################
# Replication
############################################################
# One rule per stage rather than per shot, as in pipeline 1: a failed kinetic
# replication cannot then invalidate a Thomson product that already reached
# `main`, and a retry re-sends only what failed.
if REPLICATION_ENABLED:

    # Four stages own `core_profiles` in `main`; each lands after the one it overlays.
    OVERLAID_BY = {
        "composition": [PATHS.shot_pattern("replication_record", "core_profiles")],
        "ti_inferred": [PATHS.shot_pattern("replication_record", "composition")],
        "resistive_zeff": [PATHS.shot_pattern("replication_record", "ti_inferred")],
    }

    for _stage in STAGES:

        rule:
            name: "replicate_" + _stage + "_to_hsds"
            input:
                ods=PATHS.shot_pattern(_stage + "_ods"),
                manifest=PATHS.shot_pattern(_stage + "_manifest"),
                # `composition` overlays the IDS `core_profiles` owns in the same
                # source, so it must reach `main` second: its record waits for
                # the measured product's, whatever its outcome (a skipped
                # replication writes a record too).
                after=OVERLAID_BY.get(_stage, [])
            output:
                record=PATHS.shot_pattern("replication_record", _stage)
            log:
                PATHS.shot_pattern("log", "replicate_" + _stage + "_to_hsds")
            params:
                stage=_stage
            resources:
                hsds=1
            conda:
                CONDA if CONDA else None
            shell:
                """
                mkdir -p $(dirname {log})
                python {REPLICATE_SCRIPT} \
                    --shot {wildcards.shot} \
                    --stage {params.stage} \
                    --filedb-root {BASE_DIR} \
                    --attempts {REPLICATION_ATTEMPTS} \
                    --retry-delay {REPLICATION_RETRY_DELAY} \
                    > {log} 2>&1
                """
