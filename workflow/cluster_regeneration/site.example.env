# Site settings for workflow/cluster_regeneration. Copy to ~/.config/vaft/regen.env (or point
# VAFT_REGEN_ENV at your copy), fill it in, `chmod 600` it, and never commit the filled-in copy:
# hosts, ports, user names, accounts, partitions and cluster paths stay out of the repository.

# --- on the cluster ------------------------------------------------------------------------
# The run root: env.sh, srvns, raw/, the pinned src/env and the runs live under it.
REGEN_ROOT=$HOME/regen
# A Python 3.14 with uv beside it, for setup_env.sh.
REGEN_PYTHON=$HOME/opt/python3.14/bin/python
# Where lanes are submitted (python -m vaft.database.campaign launch --backend slurm).
VAFT_SLURM_ACCOUNT=<account>
VAFT_SLURM_PARTITION=<partition>
# VAFT_SLURM_QOS=<qos>
# VAFT_SLURM_ARGS="--nodelist=<node>"          # further sbatch options, if the site needs any
# The execution policy every submission is checked against (vaft.code.policy), and the
# approval the administrator agreed to for this run.
VAFT_SLURM_CLUSTER=<cluster name in the policy>
VAFT_EXECUTION_POLICY=$HOME/.config/vaft/execution-policy.yaml
VAFT_EXECUTION_APPROVAL=<approval id>

# --- on the workstation that relays data (copy_raw.sh, push_products.sh) ------------------
VAFT_REGEN_CLUSTER_SSH="-p <port> <user>@<cluster login host>"
VAFT_REGEN_SERVER_SSH="-p <port> <user>@<production server>"
# The run root on the cluster, relative to the cluster user's home.
VAFT_REGEN_REMOTE_ROOT=regen
